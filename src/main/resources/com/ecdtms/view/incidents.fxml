<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecdtms.controller.IncidentController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #111827;
                     -fx-padding: 15;">

            <Label text="Incident Management"
                   textFill="#38bdf8">

                <font>
                    <Font name="System Bold" size="24.0" />
                </font>

            </Label>

            <!-- spacer -->
            <HBox HBox.hgrow="ALWAYS" />

            <Button text="Back to Dashboard"
                    onAction="#onBackClick"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 8 12;
                           -fx-cursor: hand;" />

        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>

        <VBox spacing="25.0"
              style="-fx-padding: 25;">

            <!-- PAGE TITLE -->
            <Label text="Security Incidents"
                   textFill="white">

                <font>
                    <Font name="System Bold" size="28.0" />
                </font>

            </Label>

            <!-- INCIDENT FORM -->
            <VBox spacing="15.0"
                  style="-fx-background-color: #1e293b;
                         -fx-background-radius: 12;
                         -fx-padding: 20;">

                <Label text="Create New Incident"
                       textFill="#38bdf8">

                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>

                </Label>

                <TextField fx:id="txtIncidentTitle"
                           promptText="Incident Title"
                           style="-fx-background-color: #0f172a;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #64748b;
                                  -fx-background-radius: 6;
                                  -fx-padding: 8;" />

                <ComboBox fx:id="comboDevice"
                          promptText="Select Affected Device ID"
                          style="-fx-background-color: #0f172a;
                                 -fx-text-fill: white;" />

                <ComboBox fx:id="comboStatus"
                          promptText="Select Incident Status"
                          style="-fx-background-color: #0f172a;
                                 -fx-text-fill: white;" />

                <ComboBox fx:id="comboThreat"
                          promptText="Select Detected Threat"
                          style="-fx-background-color: #0f172a;
                                 -fx-text-fill: white;" />


                <Button text="Save Incident"
                        onAction="#onSaveIncident"
                        style="-fx-background-color: #3b82f6;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 10;
                               -fx-cursor: hand;" />

            </VBox>

            <!-- INCIDENTS TABLE -->
            <VBox spacing="15.0"
                  style="-fx-background-color: #1e293b;
                         -fx-background-radius: 12;
                         -fx-padding: 20;">

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Incident Records"
                           textFill="white">

                        <font>
                            <Font name="System Bold" size="20.0" />
                        </font>

                    </Label>

                    <HBox HBox.hgrow="ALWAYS" />

                    <Button mnemonicParsing="false"
                            onAction="#onRefreshIncidents"
                            style="-fx-background-color: #22c55e;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 8 14;"
                            text="Refresh"/>

                    <Button mnemonicParsing="false"
                            onAction="#onUpdateIncident"
                            style="-fx-background-color: #3b82f6;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 8 14;"
                            text="Update"/>

                    <Button mnemonicParsing="false"
                            onAction="#onDeleteIncident"
                            style="-fx-background-color: #ef4444;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 8 14;"
                            text="Delete"/>
                </HBox>

                <TableView fx:id="incidentsTable"
                           prefHeight="300.0"
                           style="-fx-background-color: #0f172a;
                                  -fx-control-inner-background: #0f172a;
                                  -fx-table-cell-border-color: #1e293b;
                                  -fx-text-background-color: white;">

                    <columns>

                        <TableColumn fx:id="colIncidentId"
                                     prefWidth="120.0"
                                     text="Incident ID" />

                        <TableColumn fx:id="colTitle"
                                     prefWidth="250.0"
                                     text="Title" />

                        <TableColumn fx:id="colDevice"
                                     prefWidth="180.0"
                                     text="Device" />

                        <TableColumn fx:id="colThreat"
                                     prefWidth="180.0"
                                     text="Threat" />

                        <TableColumn fx:id="colStatus"
                                     prefWidth="150.0"
                                     text="Status" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>

