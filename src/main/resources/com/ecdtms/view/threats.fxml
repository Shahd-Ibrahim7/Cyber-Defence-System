<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1000.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecdtms.controller.ThreatController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #111827; -fx-padding: 18;">

            <Label text="Threat Intelligence Center" textFill="#38bdf8">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>

            <!-- spacer -->
            <HBox HBox.hgrow="ALWAYS"/>

            <Button text="Back to Dashboard"
                    onAction="#onBackClick"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 8 14;
                           -fx-cursor: hand;"/>

        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
            </padding>

            <!-- LEFT SIDE -->
            <VBox spacing="20.0" prefWidth="320.0">

                <!-- ADD THREAT CARD -->
                <VBox spacing="12.0"
                      style="-fx-background-color: #1e293b;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="Register New Threat" textFill="white">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>

                    <Label text="Threat ID" textFill="#cbd5e1"/>
                    <TextField fx:id="txtThreatId"
                               promptText="TH-001"
                               style="-fx-background-color: #0f172a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #64748b;
                                      -fx-border-color: #334155;
                                      -fx-background-radius: 6;
                                      -fx-border-radius: 6;"/>

                    <Label text="Description" textFill="#cbd5e1"/>
                    <TextArea fx:id="txtDescription"
                              prefHeight="120.0"
                              promptText="Threat description..."
                              wrapText="true"
                              style="-fx-background-color: #0f172a;
                                     -fx-text-fill: white;
                                     -fx-prompt-text-fill: #64748b;
                                     -fx-border-color: #334155;
                                     -fx-background-radius: 6;
                                     -fx-border-radius: 6;"/>

                    <Label text="Severity Level" textFill="#cbd5e1"/>
                    <ChoiceBox fx:id="choiceSeverity"
                               prefWidth="260.0"
                               style="-fx-background-color: #0f172a;
                                      -fx-mark-color: white;"/>

                    <Button mnemonicParsing="false"
                            onAction="#onAddThreat"
                            style="-fx-background-color: #3b82f6;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Add Threat"/>
                </VBox>

                <!-- QUICK STATS -->
                <VBox spacing="10.0"
                      style="-fx-background-color: #1e293b;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="Threat Statistics" textFill="white">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>

                    <Label text="Critical Threats: 7" textFill="#ef4444"/>
                    <Label text="High Severity: 12" textFill="#f97316"/>
                    <Label text="Medium Severity: 20" textFill="#facc15"/>
                    <Label text="Low Severity: 9" textFill="#22c55e"/>
                </VBox>

            </VBox>

            <!-- RIGHT SIDE -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">

                <Label text="Threat Intelligence Database" textFill="white">
                    <font>
                        <Font name="System Bold" size="20.0"/>
                    </font>
                </Label>

                <TableView fx:id="threatsTable" prefHeight="520.0"
                           style="-fx-background-color: #1e293b;
                                  -fx-control-inner-background: #0f172a;
                                  -fx-table-cell-border-color: #334155;
                                  -fx-border-color: #334155;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;">

                    <columns>
                        <TableColumn fx:id="colThreatId" prefWidth="140.0" text="Threat ID"/>
                        <TableColumn fx:id="colThreatDescription" prefWidth="350.0" text="Description"/>
                        <TableColumn fx:id="colThreatSeverity" prefWidth="160.0" text="Severity"/>
                        <TableColumn prefWidth="180.0" text="Threat Type"/>
                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">

                    <Button mnemonicParsing="false"
                            onAction="#onRefreshThreats"
                            style="-fx-background-color: #22c55e;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Refresh Data"/>

                    <Button mnemonicParsing="false"
                            onAction="#onDeleteThreat"
                            style="-fx-background-color: #ef4444;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Delete Threat"/>

                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>

