<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="650.0" prefWidth="1050.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #111827; -fx-padding: 18;">

            <Label text="User Management Panel" textFill="#38bdf8">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>

            <!-- spacer -->
            <HBox HBox.hgrow="ALWAYS" />

            <Button text="Back to Dashboard"
                    onAction="#onBackClick"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 8 14;
                           -fx-cursor: hand;" />

        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
            </padding>

            <!-- LEFT SIDE -->
            <VBox spacing="20.0" prefWidth="320.0">

                <!-- CREATE USER CARD -->
                <VBox spacing="12.0"
                      style="-fx-background-color: #1e293b;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="Create New User" textFill="white">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>

                    <Label text="Full Name" textFill="#cbd5e1"/>
                    <TextField promptText="Enter full name"
                               style="-fx-background-color: #0f172a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #64748b;
                                      -fx-border-color: #334155;
                                      -fx-background-radius: 6;
                                      -fx-border-radius: 6;" />

                    <Label text="Email Address" textFill="#cbd5e1"/>
                    <TextField promptText="user@ecdtms.com"
                               style="-fx-background-color: #0f172a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #64748b;
                                      -fx-border-color: #334155;
                                      -fx-background-radius: 6;
                                      -fx-border-radius: 6;" />

                    <Label text="Username" textFill="#cbd5e1"/>
                    <TextField promptText="Username"
                               style="-fx-background-color: #0f172a;
                                      -fx-text-fill: white;
                                      -fx-prompt-text-fill: #64748b;
                                      -fx-border-color: #334155;
                                      -fx-background-radius: 6;
                                      -fx-border-radius: 6;" />

                    <Label text="Password" textFill="#cbd5e1"/>
                    <PasswordField promptText="Secure password"
                                   style="-fx-background-color: #0f172a;
                                          -fx-text-fill: white;
                                          -fx-prompt-text-fill: #64748b;
                                          -fx-border-color: #334155;
                                          -fx-background-radius: 6;
                                          -fx-border-radius: 6;" />

                    <Label text="Role" textFill="#cbd5e1"/>
                    <ChoiceBox prefWidth="260.0"
                               style="-fx-background-color: #0f172a;
                                      -fx-mark-color: white;" />

                    <Button mnemonicParsing="false"
                            style="-fx-background-color: #3b82f6;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Create User"/>
                </VBox>

                <!-- SECURITY STATS -->
                <VBox spacing="10.0"
                      style="-fx-background-color: #1e293b;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="Access Statistics" textFill="white">
                        <font>
                            <Font name="System Bold" size="18.0"/>
                        </font>
                    </Label>

                    <Label text="Total Users: 28" textFill="#38bdf8"/>
                    <Label text="Admins: 4" textFill="#ef4444"/>
                    <Label text="Security Analysts: 10" textFill="#22c55e"/>
                    <Label text="SOC Managers: 3" textFill="#facc15"/>
                </VBox>
            </VBox>

            <!-- RIGHT SIDE -->
            <VBox spacing="15.0" HBox.hgrow="ALWAYS">

                <Label text="System Users" textFill="white">
                    <font>
                        <Font name="System Bold" size="20.0"/>
                    </font>
                </Label>

                <TableView prefHeight="520.0"
                           style="-fx-background-color: #1e293b;
                                  -fx-control-inner-background: #0f172a;
                                  -fx-table-cell-border-color: #334155;
                                  -fx-border-color: #334155;
                                  -fx-background-radius: 8;
                                  -fx-border-radius: 8;">

                    <columns>

                        <TableColumn prefWidth="120.0" text="User ID"/>

                        <TableColumn prefWidth="220.0" text="Full Name"/>

                        <TableColumn prefWidth="220.0" text="Email"/>

                        <TableColumn prefWidth="170.0" text="Role"/>

                        <TableColumn prefWidth="150.0" text="Status"/>

                    </columns>
                </TableView>

                <HBox alignment="CENTER_RIGHT" spacing="12.0">

                    <Button mnemonicParsing="false"
                            style="-fx-background-color: #22c55e;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Refresh"/>

                    <Button mnemonicParsing="false"
                            style="-fx-background-color: #f59e0b;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Edit User"/>

                    <Button mnemonicParsing="false"
                            style="-fx-background-color: #ef4444;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Delete User"/>

                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>