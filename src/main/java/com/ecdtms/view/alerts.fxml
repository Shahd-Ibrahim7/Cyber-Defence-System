<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecdtms.controller.AlertController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #111827; -fx-padding: 18;">

            <Label text="Security Alerts Center" textFill="#38bdf8">
                <font>
                    <Font name="System Bold" size="28.0"/>
                </font>
            </Label>

            <!-- spacer -->
            <HBox HBox.hgrow="ALWAYS" />

            <Button text="Back to Dashboard"
                    onAction="#onBackClick"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 8 14;
                           -fx-cursor: hand;" />

        </HBox>
    </top>

    <!-- CENTER CONTENT -->
    <center>
        <VBox spacing="20.0">
            <padding>
                <Insets top="25.0" right="25.0" bottom="25.0" left="25.0"/>
            </padding>

            <!-- ALERT SUMMARY -->
            <HBox spacing="20.0">

                <VBox prefWidth="180.0"
                      spacing="8.0"
                      style="-fx-background-color: #1e293b; -fx-background-radius: 10; -fx-padding: 20;">

                    <Label text="Critical Alerts" textFill="#94a3b8"/>

                    <Label text="5" textFill="#ef4444">
                        <font>
                            <Font name="System Bold" size="30.0"/>
                        </font>
                    </Label>
                </VBox>

                <VBox prefWidth="180.0"
                      spacing="8.0"
                      style="-fx-background-color: #1e293b; -fx-background-radius: 10; -fx-padding: 20;">

                    <Label text="Warnings" textFill="#94a3b8"/>

                    <Label text="12" textFill="#facc15">
                        <font>
                            <Font name="System Bold" size="30.0"/>
                        </font>
                    </Label>
                </VBox>

                <VBox prefWidth="180.0"
                      spacing="8.0"
                      style="-fx-background-color: #1e293b; -fx-background-radius: 10; -fx-padding: 20;">

                    <Label text="Resolved" textFill="#94a3b8"/>

                    <Label text="18" textFill="#22c55e">
                        <font>
                            <Font name="System Bold" size="30.0"/>
                        </font>
                    </Label>
                </VBox>

            </HBox>

            <!-- ALERT LIST SECTION -->
            <VBox spacing="12.0"
                  style="-fx-background-color: #1e293b; -fx-background-radius: 12; -fx-padding: 20;">

                <Label text="Live Security Alerts" textFill="white">
                    <font>
                        <Font name="System Bold" size="18.0"/>
                    </font>
                </Label>

                <ListView fx:id="listAlerts"
                          prefHeight="320.0"
                          style="-fx-control-inner-background: #0f172a;
                                 -fx-background-color: #0f172a;
                                 -fx-text-fill: white;
                                 -fx-border-color: #334155;
                                 -fx-border-radius: 6;
                                 -fx-background-radius: 6;" />

                <!-- BUTTONS -->
                <HBox alignment="CENTER_RIGHT" spacing="12.0">

                    <Button mnemonicParsing="false"
                            onAction="#onDismissAlert"
                            style="-fx-background-color: #ef4444;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Dismiss Alert"/>

                    <Button mnemonicParsing="false"
                            style="-fx-background-color: #3b82f6;
                                   -fx-text-fill: white;
                                   -fx-font-weight: bold;
                                   -fx-background-radius: 6;
                                   -fx-padding: 10 18;"
                            text="Refresh Alerts"/>

                </HBox>
            </VBox>
        </VBox>
    </center>

</BorderPane>