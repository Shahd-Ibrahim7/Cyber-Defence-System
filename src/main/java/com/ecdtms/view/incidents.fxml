<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="700.0"
            prefWidth="1100.0"
            style="-fx-background-color: #0f172a;"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ecdtms.controller.IncidentController">

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT"
              spacing="15.0"
              style="-fx-background-color: #111827;
                     -fx-padding: 15;">

            <Label text="Incident Management"
                   textFill="#38bdf8">

                <font>
                    <Font name="System Bold" size="24.0" />
                </font>

            </Label>

            <!-- spacer -->
            <HBox HBox.hgrow="ALWAYS" />

            <Button text="Back to Dashboard"
                    onAction="#onBackClick"
                    style="-fx-background-color: #ef4444;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 8 12;
                           -fx-cursor: hand;" />

        </HBox>
    </top>

    <!-- LEFT SIDEBAR -->
    <left>

        <VBox prefWidth="220.0"
              spacing="15.0"
              style="-fx-background-color: #111827;
                     -fx-padding: 20;">

            <Label text="Navigation"
                   textFill="white">

                <font>
                    <Font name="System Bold" size="18.0" />
                </font>

            </Label>

            <Button text="Dashboard"
                    maxWidth="Infinity"
                    style="-fx-background-color: #1e293b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 10;" />

            <Button text="Threats"
                    maxWidth="Infinity"
                    style="-fx-background-color: #1e293b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 10;" />

            <Button text="Alerts"
                    maxWidth="Infinity"
                    style="-fx-background-color: #1e293b;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-background-radius: 6;
                           -fx-padding: 10;" />

        </VBox>

    </left>

    <!-- CENTER CONTENT -->
    <center>

        <VBox spacing="25.0"
              style="-fx-padding: 25;">

            <!-- PAGE TITLE -->
            <Label text="Security Incidents"
                   textFill="white">

                <font>
                    <Font name="System Bold" size="28.0" />
                </font>

            </Label>

            <!-- INCIDENT FORM -->
            <VBox spacing="15.0"
                  style="-fx-background-color: #1e293b;
                         -fx-background-radius: 12;
                         -fx-padding: 20;">

                <Label text="Create New Incident"
                       textFill="#38bdf8">

                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>

                </Label>

                <TextField fx:id="txtIncidentTitle"
                           promptText="Incident Title"
                           style="-fx-background-color: #0f172a;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #64748b;
                                  -fx-background-radius: 6;
                                  -fx-padding: 8;" />

                <TextField fx:id="txtDeviceId"
                           promptText="Affected Device ID"
                           style="-fx-background-color: #0f172a;
                                  -fx-text-fill: white;
                                  -fx-prompt-text-fill: #64748b;
                                  -fx-background-radius: 6;
                                  -fx-padding: 8;" />

                <ComboBox fx:id="comboStatus"
                          promptText="Select Incident Status"
                          style="-fx-background-color: #0f172a;
                                 -fx-text-fill: white;" />

                <Button text="Save Incident"
                        onAction="#onSaveIncident"
                        style="-fx-background-color: #3b82f6;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-background-radius: 6;
                               -fx-padding: 10;
                               -fx-cursor: hand;" />

            </VBox>

            <!-- INCIDENTS TABLE -->
            <VBox spacing="15.0"
                  style="-fx-background-color: #1e293b;
                         -fx-background-radius: 12;
                         -fx-padding: 20;">

                <Label text="Incident Records"
                       textFill="white">

                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>

                </Label>

                <TableView prefHeight="300.0"
                           style="-fx-background-color: #0f172a;
                                  -fx-control-inner-background: #0f172a;
                                  -fx-table-cell-border-color: #1e293b;
                                  -fx-text-background-color: white;">

                    <columns>

<TableColumn prefWidth="120.0"
                                     text="Incident ID" />

                        <TableColumn prefWidth="250.0"
                                     text="Title" />

                        <TableColumn prefWidth="180.0"
                                     text="Device" />

                        <TableColumn prefWidth="180.0"
                                     text="Threat" />

                        <TableColumn prefWidth="150.0"
                                     text="Status" />

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </center>

</BorderPane>