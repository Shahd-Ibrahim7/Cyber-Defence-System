<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER"
      prefHeight="500.0"
      prefWidth="400.0"
      spacing="15.0"
      style="-fx-background-color: #0f172a;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ecdtms.controller.LoginController">

    <padding>
        <Insets bottom="40.0"
                left="40.0"
                right="40.0"
                top="40.0" />
    </padding>

    <Label text="ECDTMS" textFill="#38bdf8">
        <font>
            <Font name="System Bold" size="36.0" />
        </font>
    </Label>

    <Label text="Cyber Defense System" textFill="#94a3b8">
        <font>
            <Font size="14.0" />
        </font>

        <VBox.margin>
            <Insets bottom="30.0" />
        </VBox.margin>
    </Label>

    <VBox maxWidth="300.0" spacing="8.0">

        <Label text="Username" textFill="#e2e8f0">
            <font>
                <Font name="System Bold" size="12.0" />
            </font>
        </Label>

        <TextField fx:id="txtUsername"
                   promptText="Enter system username"
                   style="-fx-background-color: #1e293b;
                          -fx-text-fill: white;
                          -fx-prompt-text-fill: #64748b;
                          -fx-border-color: #334155;
                          -fx-border-radius: 4;
                          -fx-background-radius: 4;
                          -fx-padding: 8;" />

        <Label text="Password" textFill="#e2e8f0">

            <font>
                <Font name="System Bold" size="12.0" />
            </font>

            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>

        </Label>

        <PasswordField fx:id="txtPassword"
                       promptText="Enter secure password"
                       style="-fx-background-color: #1e293b;
                              -fx-text-fill: white;
                              -fx-prompt-text-fill: #64748b;
                              -fx-border-color: #334155;
                              -fx-border-radius: 4;
                              -fx-background-radius: 4;
                              -fx-padding: 8;" />
    </VBox>

    <Button text="SECURE LOGIN"
            maxWidth="300.0"
            mnemonicParsing="false"
            onAction="#onLoginClick"
            style="-fx-background-color: #3b82f6;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;
                   -fx-background-radius: 4;
                   -fx-padding: 10;">

        <VBox.margin>
            <Insets top="20.0" />
        </VBox.margin>

        <font>
            <Font size="14.0" />
        </font>

    </Button>

</VBox>